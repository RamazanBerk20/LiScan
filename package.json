{
  "name": "liscan",
  "private": true,
  "version": "1.0.0",
  "description": "A clear, complete disk usage scanner for Linux",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamazanBerk20/LiScan.git"
  },
  "homepage": "https://github.com/RamazanBerk20/LiScan",
  "bugs": {
    "url": "https://github.com/RamazanBerk20/LiScan/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:container": "cargo build --manifest-path src-tauri/admin-helper/Cargo.toml --target-dir src-tauri/target --locked && LISCAN_ADMIN_DIRECT=1 tauri dev",
    "build": "tsc -b && vite build",
    "check": "pnpm test && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml --all-targets --locked && cargo test --manifest-path src-tauri/admin-helper/Cargo.toml --target-dir src-tauri/target --locked",
    "package:linux": "bash scripts/package-linux.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@tauri-apps/cli": "^2.8.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.3.0"
}
